# Copy this file to .env and fill in what you need.
# The local (Ollama) path works with ZERO keys set below — that's required by
# the assignment brief. Only ANTHROPIC_API_KEY is needed to use the cloud path.

# ---- Database -----------------------------------------------------------
# docker-compose overrides this to point at the `db` service automatically;
# only needed here for running the backend outside Docker. Note: the db
# container's host-exposed port defaults to 5433 (not 5432), since many dev
# machines already run a local Postgres on 5432 — see POSTGRES_HOST_PORT
# below if you want psql access from the host.
DATABASE_URL=postgresql+asyncpg://lenny:lenny@localhost:5433/lenny
POSTGRES_HOST_PORT=5433

# ---- Provider toggle ------------------------------------------------------
# "ollama" (default, no keys required) or "anthropic" (requires the key below).
# This is the process-wide default for new sessions; each session can also be
# switched at runtime from the UI without restarting anything.
LLM_PROVIDER=ollama

# ---- Anthropic / Claude Agent SDK -----------------------------------------
# Required only if LLM_PROVIDER=anthropic or you want to switch to it live
# from the UI. Get one at https://platform.claude.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Ollama (local, mandatory for the demo) --------------------------------
# docker-compose overrides OLLAMA_BASE_URL to point at the `ollama` service
# automatically; only needed here if running the backend outside Docker.
OLLAMA_BASE_URL=http://localhost:11434
# Pick a model that's comfortable on your machine. llama3.1:8b needs ~8GB RAM
# free; for constrained machines try qwen2.5:3b or phi3.5 instead.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Retrieval --------------------------------------------------------------
# Measured on CPU-only Ollama: a 5-chunk grounded prompt to llama3.1:8b took
# 200s+ to generate a reply. 3 chunks cuts that materially (and, as a side
# benefit, dilutes the answer with less marginal context). Raise this if your
# machine has a GPU or Apple Silicon (Metal) — those finish in a few seconds
# regardless of chunk count.
RETRIEVAL_TOP_K=3
# Empirically tuned against nomic-embed-text: a clearly off-topic question can
# still score ~0.45-0.48 against the nearest (irrelevant) chunk, so 0.35 let
# false citations through in testing. Re-tune if you swap embedding models.
RETRIEVAL_MIN_SCORE=0.5

# ---- Ops ----------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
# CPU-only llama3.1:8b with a full RAG prompt measured at 200s+ per reply with
# no GPU (see RETRIEVAL_TOP_K above) — this gives headroom above that rather
# than have the mandatory local-demo path fail by default on exactly the
# hardware it's meant to run on. Lower this if you're on a faster machine and
# want failures to surface faster instead of hanging.
PROVIDER_TIMEOUT_SECONDS=240

# ---- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
